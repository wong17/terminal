# Demo de clase para Windows. Ejecutar: source demo.mish
# Crea únicamente .mish-demo bajo el directorio de inicio; no elimina archivos.
pwd
ls -l
mkdir .mish-demo
cd .mish-demo
mkdir proyecto
cd proyecto
pwd
echo Hola
cd ..

# > trunca y >> añade. cat/type también pueden leer stdin con <.
echo Hola desde MiShell > saludo.txt
echo Segunda linea >> saludo.txt
cat < saludo.txt

# Creación/ejecución/espera de procesos y pipes externos.
cmd.exe /c "echo Hola desde un proceso externo" | findstr.exe Hola
findstr.exe Hola < saludo.txt > filtrado.txt
type filtrado.txt
cmd.exe /c "dir /b" | findstr.exe .txt > listado.txt
type listado.txt
# Un comando interno puede alimentar a un programa externo.
ls | findstr.exe txt > archivos-txt.txt
type archivos-txt.txt

set DEMO="Windows desde MiShell"
echo Plataforma: $DEMO
echo 'Texto literal: $DEMO | < > &'

# El job conserva toda la tubería hasta finalizar; fg espera también los flujos.
powershell.exe -NoProfile -Command "Start-Sleep -Milliseconds 600; 'trabajo terminado'" | findstr.exe terminado > trabajo.txt &
jobs
fg 1
type trabajo.txt
help syntax
cd ..
# La demo conserva la sesión abierta. Ejecutar exit durante la defensa.
